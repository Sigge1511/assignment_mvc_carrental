@using assignment_mvc_carrental
@using assignment_mvc_carrental.Models

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-action="AdminPanel" asp-controller="ApplicationUserVM">Admin Panel</a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="ApplicationUserVM" asp-action="UserPage">My Profile</a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-action="Logout" asp-controller="ApplicationUserVM" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="ApplicationUserVM" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="ApplicationUserVM" asp-action="Login">Login</a>
        </li>
    }
</ul>